#!/bin/sh
# bare: a connection with no transport. The uplink is the transport
# namespace itself ($RIDES_NS, i.e. main): a veth pair whose far end sits
# there, a default route towards it, and -- on the far end -- two policy
# rules that route everything arriving from the veth by main's own table
# and by nothing else, ahead of the rules that send main's own traffic
# into a tunnel. NAT too: the namespace's only address is link-local.
#
# The case this was written for: NetworkManager brings up the WireGuard
# tunnel in main (profile "lappy") with its default handling for a 0/0 peer
# -- the default route goes to a private table and two rules select it for
# unmarked traffic, while main's table keeps the physical uplink:
#
#     31006:  from all lookup main suppress_prefixlength 0
#     31007:  not fwmark 0xcbc6 lookup 52166
#
# Whatever must not ride the tunnel gets rules before that pair (lappy's
# own profile carries two such exemptions: a host and a uid); bare's
# traffic gets them here, bound to the life of the veth:
#
#     30200:  from all iif ve-bare lookup main
#     30201:  from all iif ve-bare unreachable
#
# The first routes by main's table. The second is what makes it a promise:
# a rule whose table holds no route is not final -- evaluation goes on to
# the next rules, which for bare are the tunnel's -- so with the uplink
# gone, bare would quietly ride the tunnel. The companion turns that
# fall-through into an error.
#
# Main-side names follow nsm's mount conventions (ve-<name> in main), so
# `nsm down` -- which deletes ve-<name> -- tears the link even when this
# script never got to run its cleanup. The namespace-side end is not
# called ve0 on purpose: `nsm status` hides ve0 as plumbing, and here it
# is the payload interface. The rules and the NAT chain die with this
# script; the ones a killed run leaves behind stay inert until the next
# run takes their place.
#
# Precondition: main's table must be the uplink. If the tunnel's default
# route sits in main itself (auto-default-route off, never-default off),
# `lookup main` leads straight into the tunnel and this recipe cannot work.
set -eu

NAME=$CONN_NAME
NS=$CONN_NS
MAIN_IF=ve-$NAME
NS_IF=eth0
# A /31 of its own, outside nsm's veth pool (169.254.100.0/23) and alias
# pool (169.254.102.0/24): the pool allocator hands out "the first free
# /31", so a connection started while bare is down could take bare's pair,
# and bare would then fail to re-assert its address. Even = main side,
# odd = namespace side.
MAIN_ADDR=169.254.53.0
NS_ADDR=169.254.53.1
# Rule priorities: anything that sorts before the tunnel's rules; the
# companion rule takes the next one. An empty value adds no rules here --
# for when they live with the tunnel's other exemptions instead
# (NetworkManager's ipv4.routing-rules on the tunnel profile:
# "priority 30200 from 169.254.53.1 table 254" and
# "priority 30201 from 169.254.53.1 type unreachable").
RULE_PREF=30200

# shellcheck disable=SC2317  # reached through the EXIT trap
cleanup() {
    if [ -n "$RULE_PREF" ]; then
        # By priority alone: the kernel keeps a rule whose device is gone
        # (detached), and this also runs after the veth has disappeared.
        ip -4 rule del pref "$RULE_PREF" 2>/dev/null || :
        ip -4 rule del pref "$((RULE_PREF + 1))" 2>/dev/null || :
    fi
    nft delete chain ip nsm "up-$NAME" 2>/dev/null || :
    ip link del "$MAIN_IF" 2>/dev/null || :
}
trap cleanup EXIT
trap 'exit 0' TERM INT HUP

# A killed predecessor leaves its rules behind: the kernel keeps them,
# detached, and re-attaches them to the next veth of that name -- so the
# adds below would meet them there. Drop by priority first.
if [ -n "$RULE_PREF" ]; then
    ip -4 rule del pref "$RULE_PREF" 2>/dev/null || :
    ip -4 rule del pref "$((RULE_PREF + 1))" 2>/dev/null || :
fi

ip link show dev "$MAIN_IF" >/dev/null 2>&1 ||
    ip link add "$MAIN_IF" type veth peer name "$NS_IF" netns "$NS"
ip addr replace "$MAIN_ADDR/31" dev "$MAIN_IF"
ip link set "$MAIN_IF" up
ip -n "$NS" addr replace "$NS_ADDR/31" dev "$NS_IF"
ip -n "$NS" link set "$NS_IF" up
ip -n "$NS" -4 route replace default via "$MAIN_ADDR" dev "$NS_IF"

# Main forwards between the veth and its uplink; nsm's mounts never needed
# that (the namespace did the forwarding), so do not count on it being on.
sysctl -q -w net.ipv4.ip_forward=1
if [ -n "$RULE_PREF" ]; then
    ip -4 rule add pref "$RULE_PREF" iif "$MAIN_IF" lookup main
    ip -4 rule add pref "$((RULE_PREF + 1))" iif "$MAIN_IF" unreachable
fi
nft -f - <<EOF
table ip nsm {
	chain up-$NAME {
		type nat hook postrouting priority srcnat; policy accept;
	}
}
flush chain ip nsm up-$NAME
add rule ip nsm up-$NAME ip saddr $NS_ADDR oifname != "$MAIN_IF" masquerade
EOF

echo "nsm bare: $NS_IF in netns $NS via $MAIN_IF in $RIDES_NS, holding" >&2
# Hold: stay in the foreground until told to stop or the link disappears
# (the supervisor restarts the run, which rebuilds everything).
while ip link show dev "$MAIN_IF" >/dev/null 2>&1; do
    sleep 5
done
exit 1
